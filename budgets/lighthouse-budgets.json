{
  "$schema": "https://json.schemastore.org/lighthouserc.json",
  "_comment": "Single source of truth for Lighthouse performance budgets. Consumed by performance/lighthouserc.json and every application repo's CI. Change a value here → all repos inherit.",
  "ci": {
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1.0 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.9 }]
      }
    }
  },
  "budgets": [
    {
      "path": "/*",
      "timings": [
        { "metric": "largest-contentful-paint", "budget": 1800 },
        { "metric": "cumulative-layout-shift", "budget": 0.1 },
        { "metric": "total-blocking-time", "budget": 200 },
        { "metric": "interactive", "budget": 3500 },
        { "metric": "speed-index", "budget": 3000 },
        { "metric": "first-contentful-paint", "budget": 1200 }
      ],
      "resourceSizes": [
        { "resourceType": "script", "budget": 300 },
        { "resourceType": "stylesheet", "budget": 50 },
        { "resourceType": "image", "budget": 500 },
        { "resourceType": "total", "budget": 1200 }
      ],
      "resourceCounts": [
        { "resourceType": "third-party", "budget": 10 },
        { "resourceType": "total", "budget": 80 }
      ]
    },
    {
      "path": "/demo/assessment/*",
      "timings": [
        { "metric": "largest-contentful-paint", "budget": 2200 },
        { "metric": "total-blocking-time", "budget": 300 }
      ]
    },
    {
      "path": "/demo/donation/*",
      "timings": [
        { "metric": "largest-contentful-paint", "budget": 2000 },
        { "metric": "cumulative-layout-shift", "budget": 0.05 }
      ]
    },
    {
      "path": "/demo/ai-assistant/*",
      "timings": [
        { "metric": "largest-contentful-paint", "budget": 2500 },
        { "metric": "total-blocking-time", "budget": 400 }
      ]
    }
  ]
}
