{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa.viavitae.com/schemas/donor.schema.json",
  "title": "Synthetic Donor",
  "description": "Schema for synthetic donor profiles. Zero real people represented.",
  "type": "object",
  "required": ["id", "first_name", "last_name", "email", "created_at"],
  "properties": {
    "id": { "type": "string", "pattern": "^donor_[a-z0-9]{8}$" },
    "first_name": { "type": "string", "minLength": 2, "maxLength": 50 },
    "last_name": { "type": "string", "minLength": 2, "maxLength": 50 },
    "email": { "type": "string", "format": "email", "pattern": "@(example\\.com|test\\.viavitae\\.com)$" },
    "phone": { "type": "string", "pattern": "^\\+3706[0-9]{7}$" },
    "address": {
      "type": "object",
      "properties": {
        "street": { "type": "string" },
        "city": { "type": "string" },
        "postal_code": { "type": "string", "pattern": "^LT-[0-9]{5}$" },
        "country": { "type": "string", "enum": ["LT", "LV", "EE", "PL"] }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "total_donated_eur": { "type": "number", "minimum": 0, "maximum": 100000 },
    "donation_count": { "type": "integer", "minimum": 0, "maximum": 500 },
    "recurring": { "type": "boolean" },
    "parish_id": { "type": "string", "pattern": "^parish_[a-z0-9]{8}$" }
  },
  "additionalProperties": false
}
