{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa.viavitae.com/schemas/tenant.schema.json",
  "title": "Tenant Schema",
  "description": "Mirrors viavitae-clients tenant schema. Contract test verifies parity.",
  "type": "object",
  "required": ["tenant_id", "name", "subdomain", "plan", "created_at"],
  "properties": {
    "tenant_id": { "type": "string", "pattern": "^tenant_[a-z0-9]{12}$" },
    "name": { "type": "string", "minLength": 3, "maxLength": 100 },
    "subdomain": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$" },
    "plan": { "type": "string", "enum": ["free", "parish", "diocese", "enterprise"] },
    "created_at": { "type": "string", "format": "date-time" },
    "active": { "type": "boolean" },
    "features": {
      "type": "array",
      "items": { "type": "string", "enum": ["donations", "assessment", "ai-assistant", "cemetery-map", "store", "sso"] }
    },
    "locale": { "type": "string", "enum": ["lt", "en", "ru", "pl", "de"] },
    "contact_email": { "type": "string", "format": "email" }
  },
  "additionalProperties": false
}
