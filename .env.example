# .env.example — viavitae-qa
#
# Non-secret URL templates and configuration. Real values are injected by
# GitHub Environments at CI time. NEVER commit actual credentials here.
#
# Copy to .env and fill in values for local development:
#   cp .env.example .env

# --- Demo template base URLs (staging) --------------------------------------
BASE_URL_DEMO_BASILICA=https://demo.viavitae.com/basilica
BASE_URL_DEMO_CATHEDRAL=https://demo.viavitae.com/cathedral
BASE_URL_DEMO_DIOCESE=https://demo.viavitae.com/diocese
BASE_URL_DEMO_DEANERIES=https://demo.viavitae.com/deaneries
BASE_URL_DEMO_PARISH_CHURCH=https://demo.viavitae.com/parish-church
BASE_URL_DEMO_FUNERAL=https://demo.viavitae.com/funeral-services
BASE_URL_DEMO_CEMETERY=https://demo.viavitae.com/cemetery-services
BASE_URL_DEMO_STORE=https://demo.viavitae.com/online-store
BASE_URL_DEMO_VENDOR=https://demo.viavitae.com/vendor-dashboard

# --- API and web staging URLs -----------------------------------------------
STAGING_API_URL=https://staging-api.viavitae.com
STAGING_WEB_URL=https://staging-web.viavitae.com

# --- Keycloak test realm ----------------------------------------------------
KEYCLOAK_TEST_REALM=viavitae-test
KEYCLOAK_TEST_URL=https://auth.staging.viavitae.com

# --- Mailhog (email assertion helper) ---------------------------------------
MAILHOG_API_URL=https://mailhog.staging.viavitae.com

# --- PII acknowledgement ----------------------------------------------------
# Set to I_UNDERSTAND to acknowledge that fixture data must be synthetic only.
NO_PII_ACK=
