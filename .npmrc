# .npmrc — viavitae-qa
# Resolve @via-vitae scoped packages from GitHub Packages.
# The GITHUB_TOKEN is injected by GitHub Actions at CI time; locally, authenticate
# with: echo "//npm.pkg.github.com/:_authToken=$GITHUB_TOKEN" >> .npmrc
# (never commit the token — this file only carries the registry mapping).

@via-vitae:registry=https://npm.pkg.github.com
