# viavitae-qa .gitignore
# Node + test artifacts superset. This repository is purely Node.js/TypeScript.
#
# Never un-ignore a secret, key or environment file. If a value must be
# committed, it is not a secret and belongs in documentation or a schema.

# --- Secrets and credentials -------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
secrets/
.secrets.baseline

# --- Node and frontend -------------------------------------------------------
node_modules/
.turbo/
.npm/
.pnp.*
*.tsbuildinfo
.eslintcache

# --- Build artefacts ---------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Test and tooling output -------------------------------------------------
playwright-report/
test-results/
k6-summary.json
k6-binary/
*.lcov
coverage/
.nyc_output/

# --- Python (for any utility scripts) ----------------------------------------
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Editors and IDEs --------------------------------------------------------
.idea/*
!.idea/runConfigurations/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.swp
*.swo
*~

# --- Operating systems -------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# --- Archives and large binaries ---------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
